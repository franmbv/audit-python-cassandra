# ==============================================================================
# Museo Atrium - Microservicio de Auditoría (Cassandra)
# Variables de Entorno de Configuración
# ==============================================================================

PORT=8080
CORS_ORIGINS=http://localhost:3000,http://localhost:8501,http://127.0.0.1:8080

# --- Modo 1: Apache Cassandra Local (Docker Compose) ---
CASSANDRA_HOST=127.0.0.1
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=museo_auditoria
CASSANDRA_USERNAME=
CASSANDRA_PASSWORD=

# --- Modo 2: DataStax Astra DB en la Nube (Opcional) ---
# Si estas dos rutas apuntan a archivos existentes, el microservicio se conectará a la nube.
ASTRA_DB_TOKEN_PATH=cluster_museo_uneg-token.json
ASTRA_DB_BUNDLE_PATH=secure-connect-cluster-museo-uneg.zip
